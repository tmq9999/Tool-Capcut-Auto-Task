# =============================================================================
# AutoManager - credentials để verify provider với API thật
# =============================================================================
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền các giá trị bên dưới
#   3. npm run verify:providers
#
# .env KHÔNG được commit (đã có trong .gitignore).
# Script chỉ gọi các endpoint ĐỌC (miễn phí). Các thao tác tốn tiền / có tác dụng
# phụ (mua email, xoay IP, mở browser) phải bật riêng bằng cờ ở cuối file.
# =============================================================================

# --- Multilogin ------------------------------------------------------------
# Chọn MỘT trong ba cách. Script ưu tiên theo thứ tự (a) -> (b) -> (c).
#
#  (a) Email + mật khẩu  [cách thường dùng]
#      Script gọi POST /user/signin, tự hash MD5 mật khẩu như API yêu cầu,
#      nhận về JWT (sống 30 phút) + refresh_token.
MULTILOGIN_EMAIL=
MULTILOGIN_PASSWORD=
#
#  (b) Token có sẵn: dán JWT + refresh token bạn đã lấy trước đó.
#      Dùng khi không muốn để mật khẩu trong file.
#      LƯU Ý: refresh bắt buộc phải có MULTILOGIN_EMAIL ở trên, vì
#      POST /user/refresh_token nhận body { email, refresh_token }.
#      Có refresh token thì script sẽ refresh để lấy JWT mới (chứng minh cặp
#      token còn dùng được); chỉ có access token thì dùng trực tiếp.
MULTILOGIN_ACCESS_TOKEN=
MULTILOGIN_REFRESH_TOKEN=
#
#  (c) Automation token [nâng cao, tùy chọn]
#      JWT dài hạn (tới no_exp) + rate limit cao hơn, thay cho JWT 30 phút.
#      Chỉ có nếu gói subscription của bạn bật automation.
#      Lấy bằng: GET https://api.multilogin.com/workspace/automation_token
#                    ?expiration_period=1h|3h|5h|16h|24h|48h|1w|2w|3w|1mo|no_exp
#                (kèm Bearer JWT từ signin) -> trả về data.token
#      Tài liệu: https://help.multilogin.com/api/automation-token
#      Bỏ trống nếu bạn không dùng.
MULTILOGIN_AUTOMATION_TOKEN=

# --- Custom Domain Mail (domain của bạn) -----------------------------------
# Không cần API key. Mỗi luồng tự sinh <username>@<domain>, OTP đọc từ
# GET {base_url}/api/emails/<address>. Sửa được trong Settings; hai biến dưới
# chỉ dùng cho script verify.
CUSTOM_MAIL_DOMAIN=oldevlk.com
CUSTOM_MAIL_API_BASE_URL=http://103.116.38.76:3000

# --- KiotProxy -------------------------------------------------------------
# Api-token trong trang quản lý KiotProxy.
# Endpoint đọc: GET /api/public/get-user-info, GET /api/public/keys,
#               POST /api/public/proxies/get-current
KIOTPROXY_API_TOKEN=

# --- Gmail94 ---------------------------------------------------------------
# API token của gmail94.com.
# Endpoint đọc: GET /api/profile, GET /api/services
GMAIL94_API_KEY=

# --- DongVanFB -------------------------------------------------------------
# API key của dongvanfb.net.
# Endpoint đọc: GET /user/balance, GET /user/account_type
DONGVANFB_API_KEY=

# =============================================================================
# Thao tác TỐN TIỀN hoặc CÓ TÁC DỤNG PHỤ - mặc định tắt.
# Chỉ đặt =1 khi bạn chủ động muốn chạy.
# =============================================================================

# Mua 1 mailbox Gmail94 (trừ tiền) rồi đọc OTP của nó.
VERIFY_GMAIL94_BUY=0
# Service slug dùng khi mua (xem GET /api/services)
GMAIL94_SERVICE=facebook

# Mua 1 mailbox DongVanFB (trừ tiền) rồi lấy OAuth2 + đọc code.
VERIFY_DONGVANFB_BUY=0
DONGVANFB_ACCOUNT_TYPE=1
DONGVANFB_QUALITY=3

# Xoay sang IP mới trên key đầu tiên (tiêu 1 lượt xoay của key).
VERIFY_KIOTPROXY_ROTATE=0

# Mở 1 quick profile Multilogin rồi tắt ngay (cần app Multilogin đang chạy).
VERIFY_MULTILOGIN_LAUNCH=0

# Mở quick profile (headed) -> đọc debug port từ /profile/quick/statuses ->
# attach Playwright qua CDP -> mở example.com -> chỉ tắt đúng profile đó.
# Cần app Multilogin đang chạy. Đây là bài test chứng minh browser điều khiển được.
VERIFY_MULTILOGIN_CDP=0
