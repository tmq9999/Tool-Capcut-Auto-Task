{
  "name": "automanager-desktop",
  "productName": "CapCut Automation",
  "version": "3.0.4",
  "type": "module",
  "description": "CapCut Automation Desktop Client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:cycletls": "node scripts/build-cycletls-bridge.mjs",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "npm run rebuild:electron",
    "test:node": "npm run rebuild:node && vitest run",
    "test:node:watch": "vitest",
    "test:electron": "npm run build && npm run rebuild:electron && electron ./scripts/run-electron-harness.cjs",
    "test": "npm run test:node && npm run test:electron",
    "verify:providers": "vitest run --config vitest.live.config.ts",
    "selectors": "tsx tools/verify-selectors.ts",
    "dist": "npm run build:cycletls && npm run build && npm run rebuild:electron && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build:cycletls && npm run build && npm run rebuild:electron && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.7",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "12.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "playwright-core": "1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "tough-cookie": "6.0.2",
    "undici": "6.28.0",
    "write-excel-file": "4.1.1",
    "ws": "8.21.3",
    "zod": "4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^9.22.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cycletls": "2.0.5",
    "electron": "^35.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fflate": "0.8.3",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "4.1.6"
  }
}
